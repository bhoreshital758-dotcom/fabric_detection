# ==========================================
# Frontend Environment Variables (Netlify)
# ==========================================

# Optional: Point to your deployed backend (e.g. Hugging Face Spaces, Render, or Railway)
# If not specified, the app defaults to '/api' (useful with Netlify proxy redirects or local dev)
# VITE_API_BASE_URL=https://your-backend-service.hf.space/api

# Optional: Firebase Authentication (if using Google OAuth)
# If omitted or left as fallback, the app runs in built-in Guest / Demo mode
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==========================================
# Backend / Server Environment Variables
# (Used on Docker / Hugging Face / Render)
# ==========================================
# GEMINI_API_KEY=your_gemini_api_key_here
# PORT=7860
# PYTHON_API_URL=http://127.0.0.1:5000/predict
